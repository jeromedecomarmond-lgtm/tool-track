<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <!-- Background rounded square -->
  <rect width="512" height="512" rx="100" fill="#0f1117"/>
  
  <!-- Orange accent bar top -->
  <rect x="0" y="0" width="512" height="12" rx="0" fill="#f5a623"/>
  <rect x="0" y="0" width="512" height="12" rx="6" fill="#f5a623"/>

  <!-- Wrench icon centered -->
  <g transform="translate(256, 230) scale(5.5)" fill="#f5a623">
    <path d="M24.34 5.21A10.42 10.42 0 0 0 14 1.5a10.5 10.5 0 0 0-4.5 19.94L22 34l2.83-2.83-9-9A10.47 10.47 0 0 0 24.34 5.21zm-2.47 12.66A6.5 6.5 0 0 1 14 19.5a6.5 6.5 0 1 1 6.5-6.5 6.47 6.47 0 0 1-1.63 4.37l-.5-.5z" transform="translate(-14,-14)"/>
  </g>

  <!-- Simpler wrench using basic shapes -->
  <g transform="translate(256, 240)">
    <!-- Handle -->
    <rect x="-18" y="20" width="36" height="100" rx="12" fill="#f5a623"/>
    <!-- Head circle -->
    <circle cx="0" cy="0" r="65" fill="#f5a623"/>
    <circle cx="0" cy="0" r="38" fill="#0f1117"/>
    <!-- Cutout notch -->
    <rect x="-20" y="-80" width="40" height="50" rx="8" fill="#0f1117"/>
  </g>

  <!-- TT text bottom -->
  <text x="256" y="430" text-anchor="middle" font-family="Arial Black, sans-serif" font-size="52" font-weight="900" fill="#f5a623" letter-spacing="4">TOOL TRACK</text>
</svg>
